---
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import BrandMark from "./ui/BrandMark.astro";
import { site } from "../config/site";

const links = [
  { href: "/#servizi", label: "Servizi" },
  { href: "/#metodo", label: "Metodo" },
  { href: "/#storie", label: "Storie" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  data-header
>
  <div class="mx-auto max-w-6xl px-5">
    <div class="flex items-center justify-between py-3.5">
      <a href="/#top" class="flex items-center gap-2.5 font-display text-lg font-semibold text-ink">
        <BrandMark class="h-7 w-7" />
        {site.name}
      </a>

      <nav class="hidden items-center gap-7 md:flex" aria-label="Principale">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="text-sm font-medium text-fumo transition-colors hover:text-ink"
            >
              {l.label}
            </a>
          ))
        }
        <Button href="/#contatti" size="md">Scrivici</Button>
      </nav>

      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-lg text-ink md:hidden"
        aria-label="Apri menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="burger" class="h-6 w-6" />
      </button>
    </div>

    <!-- Menu mobile -->
    <nav
      id="mobile-menu"
      class="mt-1 hidden rounded-2xl border border-line bg-surface p-4 shadow-lg md:hidden"
      aria-label="Menu mobile"
      data-mobile-menu
    >
      {
        links.map((l) => (
          <a
            href={l.href}
            class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-ground"
            data-mobile-link
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/#contatti"
        class="mt-2 block rounded-full bg-blu px-3 py-2.5 text-center font-semibold text-ground"
        data-mobile-link
      >
        Scrivici
      </a>
    </nav>
  </div>
</header>

<style>
  /* Sfondo sfumato dopo lo scroll (classe aggiunta dallo script) */
  [data-header].is-scrolled {
    background: color-mix(in srgb, var(--color-ground) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--color-line);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const header = document.querySelector<HTMLElement>("[data-header]");

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Chiudi menu" : "Apri menu");
  }

  toggle?.addEventListener("click", () => {
    setMenu(menu?.classList.contains("hidden") ?? false);
  });

  document
    .querySelectorAll("[data-mobile-link]")
    .forEach((l) => l.addEventListener("click", () => setMenu(false)));

  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
