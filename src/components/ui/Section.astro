---
/**
 * Contenitore di sezione con intestazione opzionale (eyebrow + titolo + sottotitolo).
 * Centralizza spaziatura e larghezza massima per coerenza fra tutte le sezioni.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  /** Riga di separazione in alto (per il ritmo della one-page). */
  divider?: boolean;
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  subtitle,
  divider = false,
  class: className = "",
} = Astro.props;
---

<section
  id={id}
  class={`scroll-mt-20 ${divider ? "border-t border-line" : ""} ${className}`}
>
  <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    {
      (eyebrow || title || subtitle) && (
        <div class="mb-12 max-w-2xl">
          {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
          {title && (
            <h2 class="reveal mt-4 text-3xl font-semibold sm:text-4xl" style="--d:.08s">
              {title}
            </h2>
          )}
          {subtitle && (
            <p class="reveal mt-4 text-lg text-fumo" style="--d:.14s">
              {subtitle}
            </p>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>
