---
/**
 * Icone SVG inline (stroke), nessuna dipendenza esterna.
 * Uso: <Icon name="storefront" class="h-6 w-6" />
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;

const paths: Record<string, string> = {
