---
/** Marchio: una piccola bottega stilizzata (tenda a righe + bancone). */
interface Props {
  class?: string;
}
const { class: className = "h-7 w-7" } = Astro.props;
---

<svg class={className} viewBox="0 0 26 26" fill="none" aria-hidden="true">
  <rect width="26" height="26" rx="7" fill="var(--color-blu)"></rect>
  <rect x="6" y="7" width="3" height="7" rx="1.5" fill="var(--color-ground)"></rect>
  <rect x="11.5" y="7" width="3" height="7" rx="1.5" fill="var(--color-ambra)"></rect>
  <rect x="17" y="7" width="3" height="7" rx="1.5" fill="var(--color-ground)"></rect>
  <rect x="6" y="16" width="14" height="3" rx="1.5" fill="var(--color-ground)" opacity="0.55"></rect>
</svg>
