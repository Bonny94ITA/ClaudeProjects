---
import Icon from "./ui/Icon.astro";
import BrandMark from "./ui/BrandMark.astro";
import { site } from "../config/site";

const year = new Date().getFullYear();

const socials = [
  { name: "instagram", href: site.social.instagram },
  { name: "facebook", href: site.social.facebook },
  { name: "linkedin", href: site.social.linkedin },
].filter((s) => s.href && s.href !== "#");
---

<footer class="border-t border-line text-sm text-fumo">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-5 py-9">
    <a href="/#top" class="flex items-center gap-2 font-display text-base font-semibold text-ink">
      <BrandMark class="h-6 w-6" />
      {site.name}
    </a>

    <p>© {year} {site.name} — {site.tagline}, in tutta Italia. · P.IVA 00000000000</p>

    <div class="flex items-center gap-5">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
            class="text-fumo transition-colors hover:text-ink"
          >
            <Icon name={s.name} class="h-4.5 w-4.5" />
          </a>
        ))
      }
      <a href={`mailto:${site.email}`} class="hover:text-ink">{site.email}</a>
      <a href="/privacy" class="hover:text-ink">Privacy</a>
    </div>
  </div>
</footer>
