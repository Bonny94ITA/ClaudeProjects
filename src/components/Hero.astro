---
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import { whatsappUrl } from "../config/site";

const trust = [
  "Risposta in giornata",
  "Preventivo fisso, per iscritto",
  "Nessun vincolo nascosto",
];
---

<section id="top" class="overflow-hidden">
  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-32 sm:pt-40 lg:grid-cols-[1.08fr_0.92fr] lg:gap-20 lg:pb-24"
  >
    <div>
      <p class="eyebrow rise">Siti web per piccole attività</p>

      <h1 class="rise rise-2 mt-4 text-4xl font-semibold leading-[1.12] tracking-[-0.022em] sm:text-5xl lg:text-[3.6rem]">
        Sei bravo nel tuo mestiere.
        <span class="text-blu">Si deve vedere anche online.</span>
      </h1>

      <p class="rise rise-3 mt-6 max-w-xl text-lg text-fumo">
        Facciamo siti semplici, veloci e curati per artigiani, negozi e
        professionisti. Parliamo come mangiamo — e il preventivo è quello vero.
      </p>

      <div class="rise rise-4 mt-9 flex flex-wrap gap-3">
        <Button href={whatsappUrl} size="lg" target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" class="h-4.5 w-4.5" />
          Scrivici su WhatsApp
        </Button>
        <Button href="/#servizi" size="lg" variant="ghost">Guarda cosa facciamo</Button>
      </div>

      <ul class="rise rise-5 mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-fumo">
        {
          trust.map((t) => (
            <li class="inline-flex items-center gap-2">
              <Icon name="check" class="h-3.5 w-3.5 text-ambra" />
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- La vetrina digitale: elemento firma del sito.
         Passaci sopra col mouse: si accende la luce (di sera è già accesa). -->
    <div
      class="vetrina rise rise-3 relative mx-auto w-full max-w-[460px]"
      role="img"
      aria-label="Esempio di sito web per una panetteria, presentato come una vetrina di negozio con tenda a righe e cartellino Aperto"
    >
      <svg class="awning" viewBox="0 0 320 48" aria-hidden="true">
        <g>
          <rect x="0" width="40" height="28" fill="var(--awning-blu)"></rect>
          <rect x="40" width="40" height="28" fill="var(--awning-light)"></rect>
          <rect x="80" width="40" height="28" fill="var(--awning-blu)"></rect>
          <rect x="120" width="40" height="28" fill="var(--awning-light)"></rect>
          <rect x="160" width="40" height="28" fill="var(--awning-blu)"></rect>
          <rect x="200" width="40" height="28" fill="var(--awning-light)"></rect>
          <rect x="240" width="40" height="28" fill="var(--awning-blu)"></rect>
          <rect x="280" width="40" height="28" fill="var(--awning-light)"></rect>
          <circle cx="20" cy="28" r="20" fill="var(--awning-blu)"></circle>
          <circle cx="60" cy="28" r="20" fill="var(--awning-light)"></circle>
          <circle cx="100" cy="28" r="20" fill="var(--awning-blu)"></circle>
          <circle cx="140" cy="28" r="20" fill="var(--awning-light)"></circle>
          <circle cx="180" cy="28" r="20" fill="var(--awning-blu)"></circle>
          <circle cx="220" cy="28" r="20" fill="var(--awning-light)"></circle>
          <circle cx="260" cy="28" r="20" fill="var(--awning-blu)"></circle>
          <circle cx="300" cy="28" r="20" fill="var(--awning-light)"></circle>
        </g>
      </svg>

      <div class="sign" aria-hidden="true">
        <span class="sign-card">APERTO</span>
      </div>

      <div class="browser" aria-hidden="true">
        <div class="flex items-center gap-3 border-b border-line px-4 py-2.5">
          <span class="flex gap-1.5">
            <i class="h-2.5 w-2.5 rounded-full bg-line"></i>
            <i class="h-2.5 w-2.5 rounded-full bg-line"></i>
            <i class="h-2.5 w-2.5 rounded-full bg-line"></i>
          </span>
          <span class="flex-1 rounded-full bg-ground px-3.5 py-1 text-xs text-fumo">
            panetteriacolombo.it
          </span>
        </div>
        <div class="scene relative p-6">
          <p class="font-display text-xl font-semibold">Panetteria Colombo</p>
          <p class="mt-0.5 text-sm text-fumo">Pane fresco ogni mattina, a Monza dal 1962.</p>

          <!-- Il banco del pane -->
          <img
            src="/bakery.webp"
            width="880"
            height="491"
            alt="Il banco della Panetteria Colombo: cesti di panini, pagnotte e baguette appena sfornate, con il forno sullo sfondo"
            class="mt-4 block aspect-[16/9] w-full rounded-xl object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />

          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border border-line bg-ground px-3.5 py-1.5 text-xs font-semibold">
              <i class="h-1.5 w-1.5 rounded-full bg-[#4c9d64]"></i>
              Aperto ora · 7:00–19:00
            </span>
            <span class="rounded-full bg-blu px-4 py-1.5 text-sm font-semibold text-ground">
              Ordina il pane
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vetrina {
    /* Spazio per la tenda (alta ~15% della larghezza): deve coprire solo
       il bordo superiore del browser, non la barra degli indirizzi. */
    padding-top: clamp(34px, 11.5%, 52px);
  }
  .awning {
    position: absolute;
    top: 0;
    left: -4%;
    width: 108%;
    z-index: 3;
    filter: drop-shadow(0 12px 16px rgba(22, 28, 40, 0.24));
    pointer-events: none;
  }
  .browser {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 18px;
    box-shadow:
      0 2px 6px rgba(22, 28, 40, 0.06),
      0 24px 60px -18px rgba(22, 28, 40, 0.22);
    overflow: hidden;
    transition: box-shadow 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* La luce in vetrina: si accende al passaggio (di sera è già accesa) */
  .scene::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 0%, rgba(232, 163, 60, 0.34), transparent 62%);
    opacity: var(--scene-glow);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .vetrina:hover .scene::after,
  .vetrina:focus-within .scene::after {
    opacity: 0.55;
  }
  .vetrina:hover .browser {
    box-shadow:
      0 2px 6px rgba(22, 28, 40, 0.06),
      0 24px 60px -18px rgba(22, 28, 40, 0.22),
      0 0 70px -12px rgba(232, 163, 60, 0.45);
  }

  /* Cartellino APERTO appeso alla tenda */
  .sign {
    position: absolute;
    top: clamp(60px, 17%, 80px);
    right: 7%;
    z-index: 4;
    transform-origin: 50% -14px;
    animation: swing 5.5s ease-in-out infinite;
  }
  .vetrina:hover .sign {
    animation-duration: 2.4s;
  }
  .sign::before {
    /* il filo */
    content: "";
    position: absolute;
    top: -15px;
    left: 50%;
    width: 1.5px;
    height: 16px;
    background: var(--color-fumo);
  }
  .sign-card {
    display: inline-block;
    background: var(--color-ambra);
    color: var(--color-ambra-ink);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    padding: 0.4rem 0.8rem;
    border-radius: 7px;
    box-shadow: 0 6px 18px -4px rgba(232, 163, 60, 0.6);
  }
</style>
